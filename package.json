{
  "name": "febry-api",
  "version": "1.0.0",
  "description": "REST API YouTube Search + admin scaffold panel, dibangun dengan Express.js",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:pm2": "pm2-runtime start ecosystem.config.cjs",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-key": "node scripts/create-client-key.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "acorn": "^8.17.0",
    "axios": "^1.18.1",
    "axios-cookiejar-support": "^7.0.0",
    "better-sqlite3": "^12.11.1",
    "better-sqlite3-session-store": "^0.1.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5"
  }
}
