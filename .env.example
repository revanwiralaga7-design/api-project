PORT=3000
NODE_ENV=development

# Rate limit PER API KEY berdasarkan tier (bukan global, bukan per IP) —
# lihat src/middleware/identifyClient.js, requireApiKey.js & tierRateLimit.js.
# Endpoint API wajib key; user free dapat key otomatis dari login
# Google/GitHub di halaman docs. Daftar key ada di src/config/clients.json.
# admin sengaja gak ada di sini: unlimited, di-skip total dari limiter.
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_FREE_PER_HOUR=100
RATE_LIMIT_PREMIUM_PER_HOUR=1000

# Panel admin (/admin.html, /api/admin/*) MATI TOTAL kalau ini kosong.
# Isi dengan string random yang panjang, jangan dipakai ulang dari tempat lain.
# Bisa lebih dari satu key, pisah pakai koma (masing-masing setara, akses
# penuh ke panel scaffold): ADMIN_API_KEY=key-satu,key-dua,key-tiga
# Kirim lewat header "x-admin-key" dari public/admin-shared.js.
# CATATAN: ini beda sama tier "admin" di clients.json — yang ini kunci ke
# fitur scaffold (nulis kode), yang itu kuota API konsumen.
ADMIN_API_KEY=

# Rate limit khusus panel admin di atas (terpisah dari sistem tier)
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=20

# ============================================================
# Login Google/GitHub buat akses Docs (/index.html)
# ============================================================
# Beda dari ADMIN_API_KEY di atas — ini buat gerbang halaman dokumentasi
# publik (siapa aja yang mau liat/coba API harus login dulu), bukan buat
# panel scaffold. Lihat src/config/passport.js & src/routes/auth.routes.js.
# Kalau GOOGLE_* atau GITHUB_* kosong, tombol login provider itu otomatis
# mati (bukan ke-skip auth-nya — cuma provider itu yang gak bisa dipakai).

# URL publik server ini (TANPA trailing slash). Dipakai nyusun callback
# URL OAuth — harus PERSIS sama dengan yang didaftarin di provider.
# Waktu deploy, ganti ke domain aslinya, mis. https://api.punyakamu.com
APP_URL=http://localhost:3000

# String random panjang buat nandatanganin session cookie. WAJIB diisi
# sebelum online publik (kalau kosong, server tetap jalan pakai secret
# dev yang gak aman, cuma buat coba-coba lokal).
# Generate misalnya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Dari Google Cloud Console > APIs & Services > Credentials > Create
# Credentials > OAuth client ID (tipe "Web application").
# Authorized redirect URI yang didaftarin di sana harus:
#   {APP_URL}/auth/google/callback   (mis. http://localhost:3000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dari GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# Authorization callback URL yang didaftarin di sana harus:
#   {APP_URL}/auth/github/callback   (mis. http://localhost:3000/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Persistensi data (Railway/Render — filesystem EPHEMERAL!) -----------
# Tanpa volume, tiap redeploy: API key user, analytics, session — hangus.
# Pasang volume (Railway: tab Volumes, mount misal ke /data), lalu:
#
# Akar semua file data runtime (usage.json, access.log, history/, sessions/,
# cache-config.json, health-tests.json). Default: ./data di root project.
DATA_DIR=

# Lokasi clients.json (SEMUA API key konsumen — file paling penting).
# Default: src/config/clients.json. Di production arahkan ke volume,
# mis. /data/clients.json
CLIENTS_PATH=
